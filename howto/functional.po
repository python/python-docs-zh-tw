#: ../../howto/functional.rst:5
msgid "Functional Programming HOWTO"
msgstr "如何撰寫函式程式設計 (Functional Programming)"

#: ../../howto/functional.rst:0
msgid "Author"
msgstr "作者"

#: ../../howto/functional.rst:7
msgid "A. M. Kuchling"
msgstr "A. M. Kuchling"

#: ../../howto/functional.rst:0
msgid "Release"
msgstr "發佈版本"

#: ../../howto/functional.rst:8
