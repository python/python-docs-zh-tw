#: ../../howto/logging.rst:5
msgid "Logging HOWTO"
msgstr "如何使用日誌記錄 (Logging)"

#: ../../howto/logging.rst:0
msgid "Author"
msgstr "作者"

#: ../../howto/logging.rst:7
