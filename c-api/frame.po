#: ../../c-api/frame.rst:4
msgid "Frame Objects"
msgstr "Frame 物件"

#: ../../c-api/frame.rst:8
msgid "The C structure of the objects used to describe frame objects."
msgstr "用來描述 frame 物件的 C 結構。"

#: ../../c-api/frame.rst:10
