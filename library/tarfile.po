msgstr "$ python -m tarfile -e monty.tar"

#: ../../library/tarfile.rst:1303
msgid ""
"You can also extract a tar archive into a different directory by passing the "
"directory's name:"
msgstr ""

#: ../../library/tarfile.rst:1306
