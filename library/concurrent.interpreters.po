#: ../../library/concurrent.interpreters.rst:397
msgid "Basic usage"
msgstr "基本用法"

#: ../../library/concurrent.interpreters.rst:399
msgid "Creating an interpreter and running code in it::"
msgstr "建立一個直譯器並在其中運行程式碼： ::"

#: ../../library/concurrent.interpreters.rst:401
msgid ""
"from concurrent import interpreters\n"
"\n"
"interp = interpreters.create()\n"
"\n"
"# Run in the current OS thread.\n"
"\n"
"interp.exec('print(\"spam!\")')\n"
"\n"
"interp.exec(\"\"\"if True:\n"
"    print('spam!')\n"
"    \"\"\")\n"
"\n"
"from textwrap import dedent\n"
"interp.exec(dedent(\"\"\"\n"
"    print('spam!')\n"
"    \"\"\"))\n"
"\n"
"def run(arg):\n"
"    return arg\n"
"\n"
"res = interp.call(run, 'spam!')\n"
"print(res)\n"
"\n"
"def run():\n"
"    print('spam!')\n"
"\n"
"interp.call(run)\n"
"\n"
"# Run in new OS thread.\n"
"\n"
"t = interp.call_in_thread(run)\n"
"t.join()"
msgstr ""

#: ../../library/concurrent.interpreters.rst:434
msgid "Communicating between interpreters with a queue::"
msgstr "使用佇列在直譯器之間溝通： ::"

#: ../../library/concurrent.interpreters.rst:436
msgid ""
"from concurrent import interpreters\n"
"\n"
"interp = interpreters.create()\n"
"queue = interpreters.create_queue()\n"
"\n"
"def worker(queue):\n"
"    queue.put('spam!')\n"
"\n"
"t = interp.call_in_thread(worker, queue)\n"
"print(queue.get())\n"
"t.join()"
msgstr ""
"from concurrent import interpreters\n"
"\n"
"interp = interpreters.create()\n"
"queue = interpreters.create_queue()\n"
"\n"
"def worker(queue):\n"
"    queue.put('spam!')\n"
"\n"
"t = interp.call_in_thread(worker, queue)\n"
"print(queue.get())\n"
"t.join()"
