#: ../../library/stdtypes.rst:3147 ../../library/stdtypes.rst:4407
msgid "``'X'``"
msgstr "``'X'``"

#: ../../library/stdtypes.rst:3147 ../../library/stdtypes.rst:4407
msgid "Signed hexadecimal (uppercase)."
msgstr ""

#: ../../library/stdtypes.rst:3149 ../../library/stdtypes.rst:4409
msgid "``'e'``"
msgstr "``'e'``"

#: ../../library/stdtypes.rst:3149 ../../library/stdtypes.rst:4409
msgid "Floating-point exponential format (lowercase)."
msgstr ""

#: ../../library/stdtypes.rst:3151 ../../library/stdtypes.rst:4411
msgid "``'E'``"
msgstr "``'E'``"

#: ../../library/stdtypes.rst:3151 ../../library/stdtypes.rst:4411
msgid "Floating-point exponential format (uppercase)."
msgstr ""

