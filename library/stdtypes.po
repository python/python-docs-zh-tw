msgstr "``'o'``"

#: ../../library/stdtypes.rst:3141 ../../library/stdtypes.rst:4401
msgid "Signed octal value."
msgstr ""

#: ../../library/stdtypes.rst:3143 ../../library/stdtypes.rst:4403
msgid "``'u'``"
msgstr "``'u'``"

#: ../../library/stdtypes.rst:3143 ../../library/stdtypes.rst:4403
