msgid "Floating-point decimal format."
msgstr ""

#: ../../library/stdtypes.rst:3155 ../../library/stdtypes.rst:4415
msgid "``'F'``"
msgstr "``'F'``"

#: ../../library/stdtypes.rst:3157 ../../library/stdtypes.rst:4417
msgid "``'g'``"
msgstr "``'g'``"

#: ../../library/stdtypes.rst:3157 ../../library/stdtypes.rst:4417
