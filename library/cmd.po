#: ../../library/cmd.rst:74
msgid "? (question mark)"
msgstr "? （問號）"

#: ../../library/cmd.rst:74
msgid "in a command interpreter"
msgstr "於 command interpreter（指令直譯器）中"

#: ../../library/cmd.rst:74
msgid "! (exclamation)"
msgstr "! （驚嘆號）"
