#: ../../library/tkinter.rst:889
msgid ""
"def turn_red(self, event):\n"
"    event.widget[\"activeforeground\"] = \"red\"\n"
"\n"
"self.button.bind(\"<Enter>\", self.turn_red)"
msgstr ""
"def turn_red(self, event):\n"
