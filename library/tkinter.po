msgstr "用於資料庫查詢的選項名稱"

#: ../../library/tkinter.rst:557
msgid "2"
msgstr "2"

#: ../../library/tkinter.rst:557
msgid "option class for database lookup"
msgstr "用於資料庫查詢的選項類別"

#: ../../library/tkinter.rst:557
