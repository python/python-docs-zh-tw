#: ../../library/turtle.rst:325
msgid ""
"Move the turtle to an absolute position. If *y* is ``None``, *x* must be a "
"pair of coordinates or a :class:`Vec2D`, for example as returned "
"by :func:`pos`. If the pen is down, a line is drawn. The turtle's heading "
"does not change."
msgstr ""

#: ../../library/turtle.rst:336
msgid ""
">>> tp = turtle.pos()\n"
">>> tp\n"
"(0.00,0.00)\n"
">>> turtle.goto(60,30)\n"
">>> turtle.pos()\n"
"(60.00,30.00)\n"
">>> turtle.goto((20,80))\n"
">>> turtle.pos()\n"
"(20.00,80.00)\n"
">>> turtle.goto(tp)\n"
">>> turtle.pos()\n"
"(0.00,0.00)"
msgstr ""
">>> tp = turtle.pos()\n"
">>> tp\n"
"(0.00,0.00)\n"
">>> turtle.goto(60,30)\n"
">>> turtle.pos()\n"
"(60.00,30.00)\n"
">>> turtle.goto((20,80))\n"
">>> turtle.pos()\n"
"(20.00,80.00)\n"
">>> turtle.goto(tp)\n"
">>> turtle.pos()\n"
"(0.00,0.00)"

#: ../../library/turtle.rst:357 ../../library/turtle.rst:1154
#: ../../library/turtle.rst:2160
msgid "a boolean"
msgstr ""

#: ../../library/turtle.rst:359
msgid ""
"Teleport, or instantly move, the turtle to an absolute position. "
"Unlike :func:`goto`, no line is drawn. If *x* or *y* is not given, that "
"coordinate is kept as it is. The turtle's heading does not change."
msgstr ""

#: ../../library/turtle.rst:363
msgid ""
"If the turtle is filling a shape, the shape drawn so far is finished and "
"filled before teleporting, and filling starts again at the new position. "
"Pass ``fill_gap=True`` to keep filling one shape instead. The teleport then "
"counts as an edge of the shape, as it would with :func:`goto`."
msgstr ""

#: ../../library/turtle.rst:374
msgid ""
">>> tp = turtle.pos()\n"
">>> tp\n"
"(0.00,0.00)\n"
">>> turtle.teleport(60)\n"
">>> turtle.pos()\n"
"(60.00,0.00)\n"
">>> turtle.teleport(y=10)\n"
">>> turtle.pos()\n"
"(60.00,10.00)\n"
">>> turtle.teleport(20, 30)\n"
">>> turtle.pos()\n"
"(20.00,30.00)"
msgstr ""
">>> tp = turtle.pos()\n"
">>> tp\n"
"(0.00,0.00)\n"
">>> turtle.teleport(60)\n"
">>> turtle.pos()\n"
"(60.00,0.00)\n"
">>> turtle.teleport(y=10)\n"
">>> turtle.pos()\n"
"(60.00,10.00)\n"
">>> turtle.teleport(20, 30)\n"
">>> turtle.pos()\n"
"(20.00,30.00)"

