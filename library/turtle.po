#: ../../library/turtle.rst:493 ../../library/turtle.rst:590
#: ../../library/turtle.rst:1576
msgid "an integer or ``None``"
msgstr "一個整數或 ``None``"

#: ../../library/turtle.rst:495
msgid ""
"Draw a circle with the given *radius*. The center is *radius* units left of "
"the turtle; *extent*, an angle, determines which part of the circle is "
"drawn. If *extent* is not given, draw the entire circle. If *extent* is not "
"a full circle, one endpoint of the arc is the current pen position. Draw the "
"arc in counterclockwise direction if *radius* is positive, otherwise in "
"clockwise direction. Finally, the turtle's heading is changed by *extent*."
msgstr ""

#: ../../library/turtle.rst:503
msgid ""
"As the circle is approximated by an inscribed regular polygon, *steps* "
"determines the number of steps to use. If not given, it will be calculated "
"automatically. May be used to draw regular polygons."
msgstr ""

#: ../../library/turtle.rst:507
msgid ""
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(50)\n"
">>> turtle.position()\n"
"(-0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(120, 180)  # draw a semicircle\n"
">>> turtle.position()\n"
"(0.00,240.00)\n"
">>> turtle.heading()\n"
"180.0"
msgstr ""

#: ../../library/turtle.rst:533 ../../library/turtle.rst:1707
#: ../../library/turtle.rst:1708
#, fuzzy
msgid "a positive integer or ``None``"
msgstr "一個非負整數或 ``None``"

#: ../../library/turtle.rst:534
msgid "a colorstring or a numeric color tuple"
msgstr ""

#: ../../library/turtle.rst:536
msgid ""
"Draw a circular dot with diameter *size*, using *color*. If *size* is not "
"given, the larger of ``pensize + 4`` and ``2 * pensize`` is used. If *color* "
"is not given, the current pencolor is used."
msgstr ""

#: ../../library/turtle.rst:540
msgid ""
">>> turtle.home()\n"
">>> turtle.dot()\n"
">>> turtle.fd(50); turtle.dot(20, \"blue\"); turtle.fd(50)\n"
">>> turtle.position()\n"
"(100.00,-0.00)\n"
">>> turtle.heading()\n"
"0.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.dot()\n"
">>> turtle.fd(50); turtle.dot(20, \"blue\"); turtle.fd(50)\n"
">>> turtle.position()\n"
"(100.00,-0.00)\n"
">>> turtle.heading()\n"
"0.0"

#: ../../library/turtle.rst:554
msgid ""
"Stamp a copy of the turtle shape onto the canvas and return its id. The "
"stamp is placed at the current turtle position. The returned id can be used "
"to delete the stamp with :func:`clearstamp`."
msgstr ""

#: ../../library/turtle.rst:558
msgid ""
">>> turtle.color(\"blue\")\n"
">>> stamp_id = turtle.stamp()\n"
">>> turtle.fd(50)"
msgstr ""
">>> turtle.color(\"blue\")\n"
">>> stamp_id = turtle.stamp()\n"
">>> turtle.fd(50)"

#: ../../library/turtle.rst:568 ../../library/turtle.rst:1401
#: ../../library/turtle.rst:1901
msgid "an integer"
msgstr "一個整數"

#: ../../library/turtle.rst:570
msgid ""
"Delete the stamp with the given *stampid*. *stampid* must be the return "
"value of a previous :func:`stamp` call."
msgstr ""

#: ../../library/turtle.rst:573
msgid ""
">>> turtle.position()\n"
"(150.00,-0.00)\n"
">>> turtle.color(\"blue\")\n"
">>> astamp = turtle.stamp()\n"
">>> turtle.fd(50)\n"
">>> turtle.position()\n"
"(200.00,-0.00)\n"
">>> turtle.clearstamp(astamp)\n"
">>> turtle.position()\n"
"(200.00,-0.00)"
msgstr ""
">>> turtle.position()\n"
"(150.00,-0.00)\n"
">>> turtle.color(\"blue\")\n"
">>> astamp = turtle.stamp()\n"
">>> turtle.fd(50)\n"
">>> turtle.position()\n"
"(200.00,-0.00)\n"
">>> turtle.clearstamp(astamp)\n"
">>> turtle.position()\n"
"(200.00,-0.00)"

#: ../../library/turtle.rst:592
msgid ""
"Delete all or the first or last *n* of the turtle's stamps. If *n* is not "
"given, delete all stamps. If *n* is positive, delete the first *n* stamps. "
"If *n* is negative, delete the last *n* stamps, so -2 deletes the last two."
msgstr ""

#: ../../library/turtle.rst:596
msgid ""
">>> for i in range(8):\n"
"...     unused_stamp_id = turtle.stamp()\n"
"...     turtle.fd(30)\n"
">>> turtle.clearstamps(2)\n"
">>> turtle.clearstamps(-2)\n"
">>> turtle.clearstamps()"
msgstr ""
">>> for i in range(8):\n"
"...     unused_stamp_id = turtle.stamp()\n"
"...     turtle.fd(30)\n"
">>> turtle.clearstamps(2)\n"
">>> turtle.clearstamps(-2)\n"
">>> turtle.clearstamps()"

#: ../../library/turtle.rst:609
msgid ""
"Undo (repeatedly) the last turtle action(s).  Number of available undo "
"actions is determined by the size of the undobuffer."
msgstr ""

